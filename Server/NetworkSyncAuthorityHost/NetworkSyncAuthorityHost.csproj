<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- 正式 Network Protocol：直接编译 Unity 使用的同一份源码 -->
    <Compile Include="../../Assets/_Scripts/FrameWork/NetworkSync/Protocol/*.cs"
             Link="Shared/NetworkSync/Protocol/%(Filename)%(Extension)" />

    <!-- 正式 Raw UDP Transport：保留原 UDP 基线 -->
    <Compile Include="../../Assets/_Scripts/FrameWork/NetworkSync/Transport/*.cs"
             Link="Shared/NetworkSync/Transport/%(Filename)%(Extension)" />

    <!-- KCP NetworkSync Adapter：Unity 与 Authority Host 共用 -->
    <Compile Include="../../Assets/_Scripts/FrameWork/NetworkSync/Kcp/*.cs"
             Link="Shared/NetworkSync/Kcp/%(Filename)%(Extension)" />

<Compile Include="../../Assets/_Scripts/FrameWork/Kcp2k/kcp/*.cs"
         Link="ThirdParty/kcp2k/kcp/%(Filename)%(Extension)" />

<Compile Include="../../Assets/_Scripts/FrameWork/Kcp2k/highlevel/*.cs"
         Link="ThirdParty/kcp2k/highlevel/%(Filename)%(Extension)" />

    <!-- 正式服务器帧输入聚合器 -->
    <Compile Include="../../Assets/_Scripts/FrameWork/NetworkSync/InputExchange/ServerInputFrameCollector.cs"
             Link="Shared/NetworkSync/InputExchange/ServerInputFrameCollector.cs" />

    <!-- KCP Client Adapter 所需拒绝原因 -->
    <Compile Include="../../Assets/_Scripts/FrameWork/NetworkSync/InputExchange/NetworkInputExchangeRejectReason.cs"
             Link="Shared/NetworkSync/InputExchange/NetworkInputExchangeRejectReason.cs" />

    <!-- Protocol / Collector 所需的纯逻辑输入类型 -->
    <Compile Include="../../Assets/_Scripts/FrameWork/ECS/Input/InputButtonFlags.cs"
             Link="Shared/ECS/Input/InputButtonFlags.cs" />

    <Compile Include="../../Assets/_Scripts/FrameWork/ECS/Input/PlayerInputSnapshot.cs"
             Link="Shared/ECS/Input/PlayerInputSnapshot.cs" />

    <Compile Include="../../Assets/_Scripts/**/PlayerInputSnapshotComparer.cs"
             Link="Shared/Rollback/PlayerInputSnapshotComparer.cs" />

    <Compile Include="../../Assets/_Scripts/**/FrameInputSet.cs"
             Link="Shared/Rollback/FrameInputSet.cs" />

    <Compile Include="../../Assets/_Scripts/**/FrameInputAccumulator.cs"
             Link="Shared/Rollback/FrameInputAccumulator.cs" />

    <Compile Include="../../Assets/_Scripts/**/IInputComparer.cs"
             Link="Shared/Rollback/IInputComparer.cs" />

    <Compile Include="../../Assets/_Scripts/**/IInputSnapshotComparer.cs"
             Link="Shared/Rollback/IInputSnapshotComparer.cs" />

    <Compile Include="../../Assets/_Scripts/**/IRollbackInputComparer.cs"
             Link="Shared/Rollback/IRollbackInputComparer.cs" />
  </ItemGroup>
</Project>
